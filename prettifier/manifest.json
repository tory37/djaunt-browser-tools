{
  "manifest_version": 3,
  "name": "Djaunt Prettifier",
  "version": "1.0.0",
  "description": "Beautifies JSON and Markdown and runs a structural comparison between two versions — which properties differ, which sections and bullets changed — with no host permissions at all.",
  "browser_specific_settings": {
    "gecko": {
      "id": "prettifier@djaunt-browser-tools",
      "strict_min_version": "121.0"
    }
  },
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Djaunt Prettifier",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
