{
  "manifest_version": 3,
  "name": "Djaunt Host Swap",
  "version": "2.0.1",
  "description": "Rewrites hosts to other hosts before the request resolves, keeping the path and query string intact.",
  "browser_specific_settings": {
    "gecko": {
      "id": "host-swap@djaunt-browser-tools",
      "strict_min_version": "121.0"
    }
  },
  "permissions": [
    "declarativeNetRequest",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Djaunt Host Swap",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
